diff --git a/tests/e2e/harness_test.go b/tests/e2e/harness_test.go
new file mode 100644
index 0000000..78bd1e7
--- /dev/null
+++ b/tests/e2e/harness_test.go
@@ -0,0 +1,324 @@
+package e2e
+
+// Harness for NewsCache end-to-end tests: a fake upstream (nntp-testkit
+// fakeserver in Store mode), a generated newscache.conf in a temp dir, and the
+// real newscache binary run either inetd style (stdin/stdout) or standalone on
+// a TCP port.
+//
+// The binary is $NEWSCACHE_BIN, default ../../src/newscache. Tests are skipped
+// when it does not exist.
+
+import (
+	"fmt"
+	"net"
+	"os"
+	"os/user"
+	"path/filepath"
+	"strings"
+	"testing"
+	"text/template"
+
+	"github.com/go-while/nntp-testkit/client"
+	"github.com/go-while/nntp-testkit/fakeserver"
+	"github.com/go-while/nntp-testkit/proc"
+)
+
+// binPath returns the newscache binary, or skips the test.
+func binPath(t *testing.T) string {
+	t.Helper()
+	p := os.Getenv("NEWSCACHE_BIN")
+	if p == "" {
+		p = "../../src/newscache"
+	}
+	abs, err := filepath.Abs(p)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if st, err := os.Stat(abs); err != nil || st.IsDir() {
+		t.Skipf("newscache binary not found at %s (set NEWSCACHE_BIN)", abs)
+	}
+	return abs
+}
+
+// env is one NewsCache instance with its own spool, config and upstream.
+type env struct {
+	t        *testing.T
+	Bin      string
+	Dir      string // temp dir holding everything
+	Conf     string // path of newscache.conf
+	Spool    string
+	LogDir   string
+	Upstream *fakeserver.Server
+	Store    *fakeserver.Store
+	Listen   string // 127.0.0.1:port for standalone mode
+
+	// Settings written into newscache.conf; change before Start*.
+	MaxConnections int
+	ClientTimeout  int
+	ServerOptions  string // Options line of the upstream server, "" = default
+	GroupTimeout   int
+	Extra          string // extra lines at the end of the config
+	AccessList     string // the whole AccessList block
+}
+
+// newEnv creates the temp dir, the fake upstream (empty Store; add groups and
+// articles through e.Store) and the default settings.
+func newEnv(t *testing.T) *env {
+	t.Helper()
+	e := &env{
+		t:              t,
+		Bin:            binPath(t),
+		Dir:            t.TempDir(),
+		Store:          fakeserver.NewStore(),
+		MaxConnections: 8,
+		ClientTimeout:  60,
+		GroupTimeout:   0,
+		AccessList:     DefaultAccessList,
+	}
+	e.Spool = filepath.Join(e.Dir, "spool")
+	e.LogDir = filepath.Join(e.Dir, "log")
+	for _, d := range []string{e.Spool, e.LogDir} {
+		if err := os.MkdirAll(d, 0o755); err != nil {
+			t.Fatal(err)
+		}
+	}
+	e.Upstream = fakeserver.New(t, fakeserver.Options{Store: e.Store})
+	e.Listen = freeAddr(t)
+	t.Cleanup(func() {
+		if t.Failed() {
+			t.Logf("upstream received %d lines:\n  %s", len(e.Upstream.Lines()),
+				strings.Join(e.Upstream.Lines(), "\n  "))
+		}
+	})
+	return e
+}
+
+// freeAddr returns a 127.0.0.1 address with a port that was free a moment ago.
+func freeAddr(t *testing.T) string {
+	t.Helper()
+	l, err := net.Listen("tcp", "127.0.0.1:0")
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer l.Close()
+	return l.Addr().String()
+}
+
+// DefaultAccessList allows inetd sessions (client name "stdin") and
+// 127.0.0.0/8 to read and post without authentication.
+const DefaultAccessList = `AccessList {
+  Client stdin {
+    allow read post
+    List *
+    Read *
+    PostTo *
+    Authentication none
+  }
+  Client 127.0.0.0/8 {
+    allow read post
+    List *
+    Read *
+    PostTo *
+    Authentication none
+  }
+  Default {
+    allow none
+  }
+}`
+
+// accessEntry returns an AccessList with one Client entry for pattern that
+// allows everything, and a Default entry that denies everything.
+func accessEntry(pattern string) string {
+	return `AccessList {
+  Client ` + pattern + ` {
+    allow read post
+    List *
+    Read *
+    PostTo *
+    Authentication none
+  }
+  Default {
+    allow none
+  }
+}`
+}
+
+var confTmpl = template.Must(template.New("conf").Parse(`# generated by tests/e2e
+ConfigVersion 5
+ServerType standalone
+Hostname newscache.test
+Admin test@newscache.test
+ListenTo {{.Listen}}
+PidFile {{.Dir}}/newscache.pid
+Username {{.User}}
+Groupname {{.Group}}
+NiceServer 0
+NiceClient 0
+NiceClean 0
+SpoolDirectory {{.Spool}}
+SpoolSize 102400
+LogDirectory {{.LogDir}}
+ClientTimeout {{.ClientTimeout}}
+MaxConnections {{.MaxConnections}}
+{{.AccessList}}
+NewsServerList {
+  Server {{.UpHost}} {{.UpPort}} {
+    Read *
+    PostTo *
+    GroupTimeout {{.GroupTimeout}}
+{{- if .ServerOptions}}
+    Options {{.ServerOptions}}
+{{- end}}
+  }
+}
+{{.Extra}}
+`))
+
+// writeConf writes newscache.conf from the current settings.
+func (e *env) writeConf() {
+	e.t.Helper()
+	u, err := user.Current()
+	if err != nil {
+		e.t.Fatal(err)
+	}
+	g, err := user.LookupGroupId(u.Gid)
+	if err != nil {
+		e.t.Fatal(err)
+	}
+	data := map[string]any{
+		"Listen":         e.Listen,
+		"Dir":            e.Dir,
+		"User":           u.Username,
+		"Group":          g.Name,
+		"Spool":          e.Spool,
+		"LogDir":         e.LogDir,
+		"ClientTimeout":  e.ClientTimeout,
+		"MaxConnections": e.MaxConnections,
+		"UpHost":         e.Upstream.Host(),
+		"UpPort":         e.Upstream.Port(),
+		"GroupTimeout":   e.GroupTimeout,
+		"ServerOptions":  e.ServerOptions,
+		"Extra":          e.Extra,
+		"AccessList":     e.AccessList,
+	}
+	var b strings.Builder
+	if err := confTmpl.Execute(&b, data); err != nil {
+		e.t.Fatal(err)
+	}
+	e.Conf = filepath.Join(e.Dir, "newscache.conf")
+	if err := os.WriteFile(e.Conf, []byte(b.String()), 0o644); err != nil {
+		e.t.Fatal(err)
+	}
+}
+
+func (e *env) procOpts(args ...string) proc.Options {
+	return proc.Options{
+		Path: e.Bin,
+		Args: append([]string{"-c", e.Conf}, args...),
+		Dir:  e.Dir,
+		Logs: []string{filepath.Join(e.LogDir, "newscache.log")},
+	}
+}
+
+// session starts newscache in inetd mode (-i) for one client session and
+// returns the strict client after reading the greeting.
+func (e *env) session() *client.Conn {
+	e.t.Helper()
+	e.writeConf()
+	p := proc.StartStdio(e.t, e.procOpts("-i"))
+	c := client.New(e.t, p.Conn())
+	if _, err := c.ReadGreeting(); err != nil {
+		e.t.Fatalf("greeting: %v", err)
+	}
+	return c
+}
+
+// standalone starts newscache as a daemon in the foreground (-n) listening on
+// e.Listen. Use dial to connect.
+func (e *env) standalone() *proc.Process {
+	e.t.Helper()
+	e.writeConf()
+	return proc.StartTCP(e.t, e.procOpts("-n"), e.Listen)
+}
+
+func (e *env) dial() *client.Conn {
+	e.t.Helper()
+	return client.Dial(e.t, e.Listen)
+}
+
+// addArticles adds n articles to a new group and returns their message-IDs.
+// Each article carries an Xref header, as real servers send one.
+func (e *env) addArticles(group string, n int) []string {
+	return e.addArticlesXref(group, n, true)
+}
+
+func (e *env) addArticlesXref(group string, n int, xref bool) []string {
+	e.Store.AddGroup(group, "test group "+group)
+	ids := make([]string, 0, n)
+	for i := 1; i <= n; i++ {
+		id := fmt.Sprintf("<%s.%d@upstream.test>", strings.ReplaceAll(group, ".", "-"), i)
+		h := []string{
+			"From: poster@upstream.test",
+			fmt.Sprintf("Subject: article %d in %s", i, group),
+		}
+		if xref {
+			h = append(h, fmt.Sprintf("Xref: upstream.test %s:%d", group, i))
+		}
+		e.Store.AddArticle(group, fakeserver.Article{
+			Number:    int64(i),
+			MessageID: id,
+			Headers:   h,
+			Body:      []string{fmt.Sprintf("body of article %d", i), "second line", ".starts with a dot"},
+		})
+		ids = append(ids, id)
+	}
+	return ids
+}
+
+// knownBug marks a test that shows a known NewsCache bug. By default the test
+// is skipped with the bug's ID; NEWSCACHE_KNOWN_BUGS=fail runs it as a normal
+// failing test (use this when working on the fix).
+func knownBug(t *testing.T, id, what string) {
+	t.Helper()
+	if os.Getenv("NEWSCACHE_KNOWN_BUGS") == "fail" {
+		t.Logf("known bug %s: %s", id, what)
+		return
+	}
+	t.Skipf("known bug %s: %s (NEWSCACHE_KNOWN_BUGS=fail to run)", id, what)
+}
+
+// logFile returns the NewsCache log, or skips when the binary logs to syslog.
+func (e *env) logFile() string {
+	e.t.Helper()
+	b, err := os.ReadFile(filepath.Join(e.LogDir, "newscache.log"))
+	if err != nil {
+		e.t.Skip("no newscache.log: binary built with syslog (configure --without-syslog to test logging)")
+	}
+	return string(b)
+}
+
+// dialRaw connects without failing on a non-2xx greeting.
+func (e *env) dialRaw() *client.Conn {
+	e.t.Helper()
+	c, err := client.TryDial(e.Listen, 0)
+	if err != nil {
+		e.t.Fatalf("dial %s: %v", e.Listen, err)
+	}
+	return c.WithTB(e.t)
+}
+
+// dialLenient connects with strict mode off, for replies that are known to
+// break the wire format (bare LF), so the test can still check the code.
+func (e *env) dialLenient() *client.Conn {
+	e.t.Helper()
+	nc, err := net.Dial("tcp", e.Listen)
+	if err != nil {
+		e.t.Fatalf("dial %s: %v", e.Listen, err)
+	}
+	c := client.New(e.t, nc)
+	c.Strict = false
+	if _, err := c.ReadGreeting(); err != nil {
+		e.t.Fatalf("greeting: %v", err)
+	}
+	return c
+}
diff --git a/tests/e2e/reader_test.go b/tests/e2e/reader_test.go
new file mode 100644
index 0000000..9c0bffb
--- /dev/null
+++ b/tests/e2e/reader_test.go
@@ -0,0 +1,260 @@
+package e2e
+
+import (
+	"strings"
+	"testing"
+	"time"
+)
+
+const noPending = 100 * time.Millisecond
+
+func TestGreetingAndQuit(t *testing.T) {
+	e := newEnv(t)
+	c := e.session()
+	if !strings.HasPrefix(c.Greeting, "200 ") {
+		t.Fatalf("greeting %q, want 200", c.Greeting)
+	}
+	c.Cmd("QUIT")
+	if err := c.ExpectNoPending(noPending); err != nil {
+		t.Fatal(err)
+	}
+}
+
+func TestModeReader(t *testing.T) {
+	e := newEnv(t)
+	c := e.session()
+	code, line := c.Cmd("MODE READER")
+	if code != 200 && code != 201 {
+		t.Fatalf("MODE READER: %q", line)
+	}
+}
+
+func TestListActive(t *testing.T) {
+	e := newEnv(t)
+	e.addArticles("test.alpha", 3)
+	e.addArticles("test.beta", 1)
+	c := e.session()
+	code, line := c.Cmd("LIST")
+	if code != 215 {
+		t.Fatalf("LIST: %q", line)
+	}
+	lines := c.ReadDotLines()
+	got := map[string]string{}
+	for _, l := range lines {
+		f := strings.Fields(l)
+		if len(f) == 4 {
+			got[f[0]] = strings.Join(f[1:], " ")
+		}
+	}
+	for _, g := range []string{"test.alpha", "test.beta"} {
+		if _, ok := got[g]; !ok {
+			t.Errorf("LIST misses %s; got %q", g, lines)
+		}
+	}
+}
+
+func TestGroupArticleHeadBody(t *testing.T) {
+	e := newEnv(t)
+	ids := e.addArticles("test.alpha", 3)
+	c := e.session()
+
+	code, line := c.Cmd("GROUP test.alpha")
+	if code != 211 {
+		t.Fatalf("GROUP: %q", line)
+	}
+	if f := strings.Fields(line); len(f) < 5 || f[1] != "3" || f[2] != "1" || f[3] != "3" {
+		t.Errorf("GROUP: %q, want 211 3 1 3 test.alpha", line)
+	}
+
+	code, line = c.Cmd("ARTICLE 2")
+	if code != 220 || !strings.Contains(line, ids[1]) {
+		t.Fatalf("ARTICLE 2: %q", line)
+	}
+	art := c.ReadDotLines()
+	if !containsLine(art, "Subject: article 2 in test.alpha") {
+		t.Errorf("ARTICLE 2: subject missing: %q", art)
+	}
+	if art[len(art)-1] != ".starts with a dot" {
+		t.Errorf("ARTICLE 2: last body line %q, want dot line un-stuffed", art[len(art)-1])
+	}
+
+	code, line = c.Cmd("HEAD %s", ids[0])
+	if code != 221 {
+		t.Fatalf("HEAD <id>: %q", line)
+	}
+	head := c.ReadDotLines()
+	if containsLine(head, "") {
+		t.Errorf("HEAD contains the blank separator line: %q", head)
+	}
+
+	code, line = c.Cmd("BODY 3")
+	if code != 222 {
+		t.Fatalf("BODY 3: %q", line)
+	}
+	body := c.ReadDotLines()
+	want := []string{"body of article 3", "second line", ".starts with a dot"}
+	if strings.Join(body, "\n") != strings.Join(want, "\n") {
+		t.Errorf("BODY 3: %q, want %q", body, want)
+	}
+	if err := c.ExpectNoPending(noPending); err != nil {
+		t.Fatal(err)
+	}
+}
+
+func TestXover(t *testing.T) {
+	e := newEnv(t)
+	e.addArticles("test.alpha", 5)
+	c := e.session()
+	c.Cmd("GROUP test.alpha")
+	code, line := c.Cmd("XOVER 1-5")
+	if code != 224 {
+		t.Fatalf("XOVER: %q", line)
+	}
+	ov := c.ReadDotLines()
+	if len(ov) != 5 {
+		t.Fatalf("XOVER: %d lines, want 5: %q", len(ov), ov)
+	}
+	for i, l := range ov {
+		f := strings.Split(l, "\t")
+		if len(f) < 8 {
+			t.Errorf("XOVER line %d has %d fields: %q", i+1, len(f), l)
+		}
+	}
+}
+
+func TestNoSuchArticle(t *testing.T) {
+	e := newEnv(t)
+	e.addArticles("test.alpha", 1)
+	c := e.session()
+	c.Cmd("GROUP test.alpha")
+	if code, line := c.Cmd("ARTICLE 99"); code != 423 {
+		t.Errorf("ARTICLE 99: %q, want 423", line)
+	}
+	if code, line := c.Cmd("ARTICLE <missing@upstream.test>"); code != 430 {
+		t.Errorf("ARTICLE <missing>: %q, want 430", line)
+	}
+	if code, line := c.Cmd("GROUP no.such.group"); code != 411 {
+		t.Errorf("GROUP no.such.group: %q, want 411", line)
+	}
+}
+
+// TestArticleCached: once fetched by number, an article is served from the
+// spool; a second NewsCache process on the same spool does not ask upstream.
+func TestArticleCached(t *testing.T) {
+	e := newEnv(t)
+	e.addArticles("test.alpha", 2)
+
+	c := e.session()
+	c.Cmd("GROUP test.alpha")
+	if code, line := c.Cmd("ARTICLE 1"); code != 220 {
+		t.Fatalf("ARTICLE 1: %q", line)
+	}
+	c.ReadDotLines()
+	c.Cmd("QUIT")
+	first := e.Upstream.Count("ARTICLE")
+	if first != 1 {
+		t.Fatalf("upstream ARTICLE count %d after the first fetch, want 1 (counts %v)", first, e.Upstream.Counts())
+	}
+
+	c2 := e.session()
+	c2.Cmd("GROUP test.alpha")
+	if code, line := c2.Cmd("ARTICLE 1"); code != 220 {
+		t.Fatalf("ARTICLE 1 from cache: %q", line)
+	}
+	c2.ReadDotLines()
+	if n := e.Upstream.Count("ARTICLE"); n != first {
+		t.Errorf("upstream ARTICLE count went from %d to %d; want served from cache (counts %v)", first, n, e.Upstream.Counts())
+	}
+}
+
+// TestArticleByMessageIDGoesUpstream documents a design limitation: NewsCache
+// has no message-ID index for its spool, so ARTICLE <id> is always forwarded
+// to the upstream server, even for an article already in the spool. If this
+// test starts failing, the behaviour changed: update the test and the docs.
+func TestArticleByMessageIDGoesUpstream(t *testing.T) {
+	e := newEnv(t)
+	ids := e.addArticles("test.alpha", 1)
+	c := e.session()
+	c.Cmd("GROUP test.alpha")
+	c.Cmd("ARTICLE 1")
+	c.ReadDotLines()
+	before := e.Upstream.Count("ARTICLE")
+	if code, line := c.Cmd("ARTICLE %s", ids[0]); code != 220 {
+		t.Fatalf("ARTICLE <id>: %q", line)
+	}
+	c.ReadDotLines()
+	if n := e.Upstream.Count("ARTICLE"); n != before+1 {
+		t.Errorf("upstream ARTICLE count %d -> %d, want +1 (forwarded)", before, n)
+	}
+}
+
+// TestOfflineServesCache: with the upstream gone, cached articles are still
+// served.
+func TestOfflineServesCache(t *testing.T) {
+	e := newEnv(t)
+	e.addArticles("test.alpha", 2)
+	c := e.session()
+	c.Cmd("GROUP test.alpha")
+	c.Cmd("ARTICLE 1")
+	c.ReadDotLines()
+	c.Cmd("QUIT")
+
+	e.Upstream.Close()
+	c2 := e.session()
+	if code, line := c2.Cmd("GROUP test.alpha"); code != 211 {
+		t.Fatalf("GROUP with upstream down: %q", line)
+	}
+	if code, line := c2.Cmd("ARTICLE 1"); code != 220 {
+		t.Fatalf("ARTICLE 1 with upstream down: %q", line)
+	}
+	c2.ReadDotLines()
+}
+
+func TestPostForwarded(t *testing.T) {
+	e := newEnv(t)
+	e.addArticles("test.alpha", 1)
+	c := e.session()
+	code, line := c.Cmd("POST")
+	if code != 340 {
+		t.Fatalf("POST: %q", line)
+	}
+	if err := c.Send("Newsgroups: test.alpha\r\nFrom: client@newscache.test\r\n" +
+		"Subject: posted through newscache\r\nMessage-ID: <post1@newscache.test>\r\n\r\n" +
+		"hello\r\n..dot line\r\n.\r\n"); err != nil {
+		t.Fatal(err)
+	}
+	code, line, err := c.ReadStatus()
+	if err != nil {
+		t.Fatal(err)
+	}
+	if code != 240 {
+		t.Fatalf("POST result: %q", line)
+	}
+	posted := e.Store.Posted()
+	if len(posted) != 1 {
+		t.Fatalf("upstream got %d posted articles, want 1", len(posted))
+	}
+	if b := posted[0].Body; len(b) != 2 || b[1] != ".dot line" {
+		t.Errorf("posted body %q, want [hello .dot line]", b)
+	}
+}
+
+func TestUnknownCommand(t *testing.T) {
+	e := newEnv(t)
+	c := e.session()
+	if code, line := c.Cmd("FOOBAR"); code != 500 {
+		t.Errorf("FOOBAR: %q, want 500", line)
+	}
+	if err := c.ExpectNoPending(noPending); err != nil {
+		t.Fatal(err)
+	}
+}
+
+func containsLine(lines []string, want string) bool {
+	for _, l := range lines {
+		if l == want {
+			return true
+		}
+	}
+	return false
+}
