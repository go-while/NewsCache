From 394e2661c8b466e48eb72dcb9c23340e0bb9442f Mon Sep 17 00:00:00 2001
From: go-while <go-while@users.noreply.github.com>
Date: Sat, 17 Oct 2026 22:40:01 +0000
Subject: [PATCH 3/8] End the access-denied reply with CRLF

"502 You have no permission to talk.  Goodbye." was sent with a bare
LF, both for the access list and for libwrap denials.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 src/NewsCache.cc | 4 ++--
 1 file changed, 2 insertions(+), 2 deletions(-)

diff --git a/src/NewsCache.cc b/src/NewsCache.cc
index 5096a58..17d427d 100644
--- a/src/NewsCache.cc
+++ b/src/NewsCache.cc
@@ -1969,7 +1969,7 @@ void nnrpd(int fd)
 				    client_logname << " denied - hosts.allow\n";
 				(*clt.
 				 co) <<
-			       "502 You have no permission to talk.  Goodbye.\n";
+			       "502 You have no permission to talk.  Goodbye.\r\n";
 				clt.co->flush ();
 				return;
 			}
@@ -2006,7 +2006,7 @@ void nnrpd(int fd)
 		slog.p(Logger::Notice) << clt.
 		    client_logname << " denied\n";
 		(*clt.
-		 co) << "502 You have no permission to talk.  Goodbye.\n";
+		 co) << "502 You have no permission to talk.  Goodbye.\r\n";
 		clt.co->flush();
 		return;
 	} else {
-- 
2.47.3

