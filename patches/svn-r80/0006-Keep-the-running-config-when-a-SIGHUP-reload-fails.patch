From 66d0c8c2693502ae2d695573731cc100a5b7dc1a Mon Sep 17 00:00:00 2001
From: go-while <go-while@users.noreply.github.com>
Date: Sat, 17 Oct 2026 22:40:01 +0000
Subject: [PATCH 6/8] Keep the running config when a SIGHUP reload fails

The accept loop re-read the config in place without catching errors,
so a typo in newscache.conf killed the daemon on SIGHUP. Parse into a
new Config, swap it in only on success, and log the error otherwise.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 src/NewsCache.cc | 17 +++++++++++++++--
 1 file changed, 15 insertions(+), 2 deletions(-)

diff --git a/src/NewsCache.cc b/src/NewsCache.cc
index f22dfb5..ed56a4a 100644
--- a/src/NewsCache.cc
+++ b/src/NewsCache.cc
@@ -2326,9 +2326,22 @@ void nntpd()
 		/* Accept connection */
 		do {
 			if (reReadConfig) {
-				Cfg.init();
-				Cfg.read(config_file);
 				reReadConfig = false;
+				// parse into a copy, so a broken file keeps
+				// the running configuration
+				try {
+					Config newCfg;
+					newCfg.read(config_file);
+					Cfg = newCfg;
+					slog.p(Logger::Notice)
+					    << "reread " << config_file << "\n";
+				}
+				catch(const Error & e) {
+					slog.p(Logger::Error)
+					    << "cannot reread " << config_file
+					    << ", keeping the old configuration: "
+					    << e._errtext << "\n";
+				}
 			}
 
 			errno = 0;
-- 
