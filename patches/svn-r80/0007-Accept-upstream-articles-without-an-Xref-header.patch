From 3eadf2c511554a3e51b222811a2daa71910cdca3 Mon Sep 17 00:00:00 2001
From: go-while <go-while@users.noreply.github.com>
Date: Sat, 17 Oct 2026 22:40:01 +0000
Subject: [PATCH 7/8] Accept upstream articles without an Xref header

CServer::filter_xref() called getfield("xref:"), which throws when the
header is missing, so such articles reached the client as 423 or 430.
Xref is optional; skip the filter when there is none.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 NServer-0.9.1/NServer.cc | 4 ++++
 1 file changed, 4 insertions(+)

diff --git a/NServer-0.9.1/NServer.cc b/NServer-0.9.1/NServer.cc
index 417f6e3..e746e63 100644
--- a/NServer-0.9.1/NServer.cc
+++ b/NServer-0.9.1/NServer.cc
@@ -1249,6 +1249,10 @@ void CServer::filter_xref(Article *art, MPListEntry *server, const char *gname)
 {
 	static const char delim[] = " \t\r\n";
 
+	// Xref is optional (RFC 3977/5536); nothing to filter without it
+	if (!art->has_field("xref:"))
+		return;
+
 	bool xref_changed = false;
 	std::string xref = art->getfield("xref:", 1);
 
-- 
