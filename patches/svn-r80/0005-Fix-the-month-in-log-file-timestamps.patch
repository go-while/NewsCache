From b8ef9604d0709b758bdcc0202f923d0bd526a3ab Mon Sep 17 00:00:00 2001
From: go-while <go-while@users.noreply.github.com>
Date: Sat, 17 Oct 2026 22:40:01 +0000
Subject: [PATCH 5/8] Fix the month in log file timestamps

struct tm's tm_mon is 0-based, so file logs (builds without syslog)
showed the previous month. Also use snprintf for the buffer.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 NVClasses-0.9.1/Logger.cc | 4 ++--
 1 file changed, 2 insertions(+), 2 deletions(-)

diff --git a/NVClasses-0.9.1/Logger.cc b/NVClasses-0.9.1/Logger.cc
index 930dec2..ee07abb 100644
--- a/NVClasses-0.9.1/Logger.cc
+++ b/NVClasses-0.9.1/Logger.cc
@@ -57,8 +57,8 @@ void Logger::print()
 		char tbuf[32];
 		time(&ts);
 		t = localtime(&ts);
-		sprintf(tbuf, "%d %04d/%02d/%02d %02d:%02d:%02d ",
-			_priority, 1900 + t->tm_year, t->tm_mon,
+		snprintf(tbuf, sizeof(tbuf), "%d %04d/%02d/%02d %02d:%02d:%02d ",
+			_priority, 1900 + t->tm_year, t->tm_mon + 1,
 			t->tm_mday, t->tm_hour, t->tm_min, t->tm_sec);
 		log << tbuf << buf << endl;
 #endif
-- 
