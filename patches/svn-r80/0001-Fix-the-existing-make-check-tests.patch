From a97523feb1b241e443304de5ee08def33bd307c2 Mon Sep 17 00:00:00 2001
From: go-while <go-while@users.noreply.github.com>
Date: Sat, 17 Oct 2026 22:40:01 +0000
Subject: [PATCH 1/8] Fix the existing make check tests

- cArticle: call Article::GetText(), not the old gettext().
- cNewsgroupFilter: add the missing using namespace std.
- newscache.conf-dist: BindFrom takes numeric addresses only since the
  IPv6 rewrite (r5), so the sample's host name made the file fail
  to load. Use an address and say so in the sample and the man page.
- cConfig: print the parse error instead of aborting, work without
  srcdir, accept a config file argument.

make check now passes all 5 tests (Ubuntu 24.04, g++ 13.3, GnuTLS).

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 NServer-0.9.1/checks/cArticle.cc         |  2 +-
 NServer-0.9.1/checks/cNewsgroupFilter.cc |  2 ++
 etc/newscache.conf-dist                  |  3 ++-
 man/newscache.conf.5.in                  |  4 +++-
 src/cConfig.cc                           | 25 +++++++++++++++++++++---
 5 files changed, 30 insertions(+), 6 deletions(-)

diff --git a/NServer-0.9.1/checks/cArticle.cc b/NServer-0.9.1/checks/cArticle.cc
index edb919a..1602a44 100644
--- a/NServer-0.9.1/checks/cArticle.cc
+++ b/NServer-0.9.1/checks/cArticle.cc
@@ -36,7 +36,7 @@ int checkArticle(const char *artfn)
 	if (la1 != art1.length() || la1 != art2->length())
 		return -12;
 
-	art1.settext(art2->gettext());
+	art1.settext(art2->GetText());
 	if (strcmp(art1.c_str(), art2->c_str()))
 		return -21;
 	if (la1 != art1.length() || la1 != art2->length())
diff --git a/NServer-0.9.1/checks/cNewsgroupFilter.cc b/NServer-0.9.1/checks/cNewsgroupFilter.cc
index b2834e9..affda55 100644
--- a/NServer-0.9.1/checks/cNewsgroupFilter.cc
+++ b/NServer-0.9.1/checks/cNewsgroupFilter.cc
@@ -2,6 +2,8 @@
 
 #include "NewsgroupFilter.h"
 
+using namespace std;
+
 #define V(x) if(verbose) { x; }
 
 NewsgroupFilter filters[] = {
diff --git a/etc/newscache.conf-dist b/etc/newscache.conf-dist
index 12b99de..bb66574 100644
--- a/etc/newscache.conf-dist
+++ b/etc/newscache.conf-dist
@@ -190,6 +190,7 @@ AccessList {
 # updatenews. The default value is 600 seconds.
 # BindFrom:
 #   Interface for outgoing connections (for multihomed hosts)
+#   Numeric IPv4 or IPv6 address only; host names are not resolved.
 #   (Code by Vladislav Bogdanov, slava@nsys.by)
 # LimitGroupSize:
 #   Limit the group size to the specified number of messages - this is
@@ -233,7 +234,7 @@ NewsServerList {
     Read at.wu-wien.*
     PostTo .none.
     GroupTimeout 300
-    BindFrom somehost.tuwien.ac.at
+    BindFrom 192.168.100.2
     Options offline not-setpostflag
   }
   NoServer {
diff --git a/man/newscache.conf.5.in b/man/newscache.conf.5.in
index 2f31f7b..9a29876 100644
--- a/man/newscache.conf.5.in
+++ b/man/newscache.conf.5.in
@@ -217,7 +217,7 @@ This parameter specifiy the name of the PAM Service. The default is newscache. Y
 	\fIRead\fR GroupSpec
 	\fIPostTo\fR GroupSpec
 	\fIGroupTimeout\fR seconds
-	\fIBindFrom\fR address (FIXME)
+	\fIBindFrom\fR address
 	\fIRetris\fR nr-of-retries
 	\fIUser\fR username
 	\fIPassword\fR password
@@ -249,6 +249,8 @@ NewsCache post an article to the best matching upstream newsserver. If the artic
 specified how long the group information (for instance retrieved with the command GROUP at.linux) is valid (in seconds). Note: if the ServerSpec section contains the Options offline, then the data will be not downloaded from the upstream server. You need
 .BR updatenews(8) .
 The default value is 600 seconds.
+.IP "BindFrom \fIaddress\fR"
+Local address used for connections to this upstream server. It must be a numeric IPv4 or IPv6 address; host names are not resolved. No default value.
 .IP "Options \fIflags\fR"
 Specifies a list of options that should be turned on or off. The default flags are: cached setpostflag. Valid flags are:
 .nf
diff --git a/src/cConfig.cc b/src/cConfig.cc
index 46c6d68..e5bc1fa 100644
--- a/src/cConfig.cc
+++ b/src/cConfig.cc
@@ -1,5 +1,8 @@
 #include <iostream>
 
+#include <stdlib.h>
+#include <unistd.h>
+
 #include "Logger.h"
 #include "Config.h"
 
@@ -10,10 +13,26 @@ Config cfg;
 
 int main(int argc, char *argv[])
 {
-	chdir(getenv("srcdir"));
-	cfg.read("../etc/newscache.conf-dist");
+	const char *srcdir = getenv("srcdir");
+	const char *fn = argc > 1 ? argv[1] : "../etc/newscache.conf-dist";
+
+	if (srcdir && chdir(srcdir) != 0) {
+		cerr << "cConfig: cannot chdir to " << srcdir << "\n";
+		exit(1);
+	}
+	try {
+		cfg.read(fn);
+	}
+	catch(const SyntaxError & se) {
+		cerr << "cConfig: " << se._errtext << "\n";
+		exit(1);
+	}
+	catch(const IOError & io) {
+		cerr << "cConfig: unexpected EOF in " << fn << "\n";
+		exit(1);
+	}
 
-	cout << "cConfig: newscache.conf-dist ok\n";
+	cout << "cConfig: " << fn << " ok\n";
 	exit(0);
 }
 
