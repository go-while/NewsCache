#!/bin/sh
# Copyright 2002 Herbert Straub

if [ -f config.cache ]; then
	rm config.cache
fi
if [ -f Makefile ]; then
	make clean
fi

echo "autoreconf..."
if ! autoreconf -i; then
	echo "autogen: autoreconf failed (are autoconf, automake and libtool installed?)" >&2
	exit 1
fi

echo "Next run ./configure"
echo "Next run make"
