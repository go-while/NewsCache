# NewsCache Configuration File
# Keywords are case-dependent!

################################################################
## Version
################################################################
# Specify the version here, if you want to get warnings about 
# incompatibilities
ConfigVersion 5

################################################################
## ServerType
################################################################
# ServerType may be either standalone or inetd.
ServerType standalone

# If you are running in standalone mode, you should specify the
# location of the pid file. Under systemd it is not needed when the
# service runs "newscache -n" (in the foreground); a service of
# Type=forking needs it, with the same path in PIDFile=. NewsCache
# removes it when it stops; for that, its directory must be writable
# for Username, otherwise the file is only emptied.
PidFile /run/newscache.pid

# The Address, where NewsCache is listening, if running in
# standalone mode.  
# In a multihomed environment the address of one NIC can be 
# specified. The default Port is nntp from /etc/services. For
# the port-number an entry fom /etc/services or a port-number
# can be specified. DEFAULT (or DEFAULT:port) listens on all IPv4
# and IPv6 addresses (on IPv4 only where the host has no IPv6);
# 0.0.0.0 listens on IPv4 only.
#
# !!! If ListenTo is specified, then the parameter CachePort
# is ignored !!!
ListenTo DEFAULT
#ListenTo 133.144.155.166
#ListenTo 133.144.155.166:12000
#ListenTo 133.144.155.166:telnet

# TLS for clients (NNTP over TLS from the first byte, RFC 8143; needs a
# build with GnuTLS): a second listening socket, same form as ListenTo,
# default port 563. Certificate (PEM, followed by its intermediate
# certificates, e.g. certbot's fullchain.pem) and its unencrypted PEM
# key. They are loaded at the start, before NewsCache switches to
# Username; SIGHUP loads them again as Username, so make the key
# readable by Groupname (mode 0640) or restart after a renewal.
# TLSPriority is an optional GnuTLS priority string (default: the
# system's). In inetd mode, newscache -t does TLS on the passed socket.
# A changed ListenTo or TLSListenTo needs a restart.
#TLSListenTo DEFAULT:563
#TLSCertFile /etc/newscache/fullchain.pem
#TLSKeyFile /etc/newscache/privkey.pem
#TLSPriority NORMAL:-VERS-ALL:+VERS-TLS1.3:+VERS-TLS1.2

# The port, where NewsCache is listening, if running in standalone
# mode. Either an entry from /etc/services or a port-number prepended
# by a #-sign.
# !!! Only valid, if the parameter ListenTo is not specified !!!
#CachePort #12000

# Only if NewsCache cannot figure out the name of your machine,
# specify the hostname here. Probably your system is _not_ set up
# correctly. Remember: hostname should return the fully qualified
# domain name
#Hostname my.host.name

################################################################
## Nice values
################################################################
# How nice values works?
# First call getpriority, take the result and add the Nicexxx
# value and call with the result priority setpriority.
# See man nice for details.
# for the master server process
NiceServer 0

# NiceClient is accepted for compatibility but ignored in this version;
# standalone session processes use NiceServer. Setting NiceClient has no
# effect.

# for the clean process
NiceClean 3

################################################################
## User and group under which NewsCache should be run
################################################################
Username news
Groupname news

# Put in here the local newscache administrator. HELP shows it to
# clients: "Report problems to ...".
Admin root@localhost

################################################################
## Client-access configuration 
## Code initially by Vladislav Bogdanov <slava@nsys.by>
## Read/PostTo options by Thomas Gschwind <tom@infosys.tuwien.ac.at>
################################################################
# Client-access configuration
# allow:
#   allow access from these hosts (default=none). Values are:
#   read, post, debug. With debug, the client can use the
#   xdebug command.
#   NOTE: if you specify debug, then the client is able to
#         read your configuration file (xdebug dump configuration)!!
#         Upstream passwords are not shown.
# List:
#   A list of newsgroups that should be shown by the
#   list [active|active.times|...] and newgroups commands
# Read:
#   A list of newsgroups that client can read without authentication
# PostTo:
#   Postings to these newsgroups should be allowed to clients without 
#   authentication
# Authentication:
#   none ... no further authentication necessary
#   file:/path/to/file ... formatdescription 
#		username:password:list:read:postto:allow
#	Only username and password are required; fields missing at
#	the end add nothing, like empty ones.
#	The additional access specification are added to the normal
#	List Read and PostTo Parameters (see above)
# 	The password field is a encrypted password (md5crypt of crypt)
#   unix:list:read:postto:allow ... use UNIX authentication
#	The additional access specification are added to the normal
#	List Read and PostTo Parameters (see above). If only unix is
#	specified, then all clients must step throuh the authentication.
#	If further fields specified, then unauthenticated clients have
# 	the access specified with the parameter allow, List, ReadTo,
#	PostTo and authenticated clients uses the arguments and modify 
#	the original parameters.
#	NewsCache checks passwords as Username (news), and only root may
#	read /etc/shadow, so unix (and pam with pam_unix) can't check
#	local accounts. Use file:, or PAM modules that work without root.
# AuthRequiresTLS yes|no:
#   yes: clients of this entry can log in only over TLS (TLSListenTo or
#   newscache -t); on a plain connection AUTHINFO gets "483 Encryption
#   required". Default no.
#
# NOTE: The first matching entry is used, so put Default last. Without a
#       Default entry the file does not load. Nothing is allowed by default:
#       a client may only read or post if a Client entry for its address or
#       network (CIDR), or an entry with Authentication (login), allows it.
#       Inetd mode (newscache -i) needs an entry for the client "stdin";
#       with newscache -t the client is matched by its address.
#       Login example: anyone may connect, but must log in first. The
#       entry allows only the login itself; the rights come from the user
#       file (user:hash:list:read:postto:allow, e.g. alice:$6$...:*:*:*:read,post).
#       With "allow read post" instead, the login would be optional and
#       clients that don't log in could read and post too.
#         Default {
#           allow authentication
#           List !*
#           Read !*
#           PostTo !*
#           Authentication file:/etc/newscache.users
#         }
#
AccessList {
  # Examples; nothing is allowed until you enable or add an entry.
#  Client stdin {
#    allow read post debug
#    # list all newsgroups, allow users to read *, and to post to * 
#    List *
#    Read *
#    PostTo *
#    # no further authentication necessary/possible
#    Authentication none
#  }
#  Client localhost {
#    allow read post
#    # list all newsgroups, allow users to read *, and to post to *
#    # No xdebug command for unauthenticated clients.
#    List *
#    Read *
#    PostTo *
#    Authentication unix::::debug
#    # all authenticated clients are able to use the xdebug command
#  }
#  Client .tuwien.ac.at {
#    allow read post
#    # list all, except for alt.* newsgroups, allow users to 
#    # read at.* and to post to at.*
#    List *,!alt.*
#    Read at.*
#    PostTo at.*
#    # allow users to gain additional privileges by
#    # authenticating based on a password file
#    # the format of the file is username:password:list:read:postto:allow
#    Authentication file:/usr/local/etc/tuwien.pass
#  }
#  Client 192.168.0.0/255.255.0.0 {
#    allow read post
#    # deny access to all newsgroups
#    List !*
#    Read !*
#    PostTo !*
#    # allow users to gain additional privileges by
#    # authenticating using standard passwd semantics
#    # allow to read * and to post to at.* after successful
#    # authentication
#    Authentication unix:*:at.*
#  }
#  Client 192.169.0.0/255.255.0.0 {
#    allow read
#    # deny access to all newsgroups
#    List at.*
#    Read at.*
#    PostTo !*
#    Authentication unix:*:*:*:debug,post
#    # allow users to gain additional privileges by
#    # authenticating using standard passwd semantics
#    # allow to read * and to post to * and can use the xdebug 
#    # command after successful authentication. 
#    # Unauthenticated clients can only read from at.* groups.
#  }
#  Client .aol.com {
#    allow none
#  }
  Default {
    allow none
  }

}

################################################################
## Server-Configuration
################################################################
# Server-Configuration:
# Read:
#   A list of newsgroups that should be read from the news server.
# PostTo:
#   Postings to these newsgroups should be handled by this server.
# GroupTimeout:
# specified how long the group information (for instance retrieved
# with the command GROUP at.linux) is valid (in seconds). Note: if
# the ServerSpec section contains the Options offline, then the
# data will be not downloaded from the upstream server. You need
# updatenews. The default value is 600 seconds.
# BindFrom:
#   Interface for outgoing connections (for multihomed hosts)
#   Numeric IPv4 or IPv6 address only; host names are not resolved.
#   (Code by Vladislav Bogdanov, slava@nsys.by)
# LimitGroupSize:
#   Limit the group size to the specified number of messages - this is
#   useful if your upstream server has very long group retention (or
#   never expires at all)
# ConnectBackoff:
#   Don't try to reconnect for specified amount of seconds after failed
#   connection attempt
# ConnectTimeout:
#   Timeout connects after specified amount of seconds
# ReadTimeout:
#   Give up a connection when the server sends (or accepts) nothing for
#   this many seconds (each read and write, not a whole reply; default
#   300, 0 = wait for ever)
# Options:
#   (not-)offline, semioffline ... retrieve nothing/everything/articles
#   (not-)setpostflag ... set postflag to n in the active database, if
#                       posting to the news server is not allowed
#   (not-)cached ... cache the articles and overview of this server's
#                    groups in the spool (the default); not-cached
#                    passes them through without storing them
#   ssl ... use TLS from the start (usually port 563)
#   starttls ... switch to TLS with STARTTLS (usually port 119); if the
#                server refuses it, the connection is dropped, not continued
#                in plain text
#   noverify ... with ssl/starttls, don't verify the server's certificate
#                (logged as a warning); only for self-signed certificates
# TLSCAFile:
#   PEM file with the CA certificates for this server's TLS certificate.
#   Without it, the system trust store is used. With ssl or starttls the
#   certificate must chain to a trusted CA, be valid and match the host name
#   in the Server line; otherwise the connection fails.
# Commands:
#   All commands are switched on by default and NewsCache tries itself
#   to find out which of the commands are supported. In some situations
#   it might be necessary to deactivate a command manually (eg. it is
#   not implemented correctly by your news server).
#   Netscape-Collabra/3.0 (used by news.elsa.de) does not implement over
#   correctly :(
#   To switch off, prepend the command with not-
#   Support commands: listgroup, over
#
# Public servers that need no payment (all on port 119, and on port 563 with
# TLS; use "Options ssl" for 563, or "Options starttls" on 119).
#   news.blueworldhosting.com            reading and posting, no account
#   archive.usenet.blueworldhosting.com  old articles, read only
#   news.eternal-september.org           needs a free account (User/Password)
#   news-ams.pugleaf.net, news-can, news-fra, news-lax, news-lon, news-sfo,
#   news-sin, news-tyo, news-wdc (.pugleaf.net; https://pugleaf.net/)
#                                        text-only, read only
NewsServerList {
  Server news.blueworldhosting.com 563 {
    Retries 3
    Read *
    PostTo *
    GroupTimeout 150
    Options ssl
    # Examples of more options:
    # BindFrom 192.168.100.1
    # Options ssl offline not-setpostflag
    # Commands not-over
  }
  # If several entries read the same groups (Read * here), the first one is
  # used. To read from one of these instead, put it in place of the entry
  # above. A pugleaf.net server near you, read only, text groups:
  #Server news-fra.pugleaf.net 563 {
  #  Read *
  #  PostTo !*
  #  Options ssl
  #}
  # Old articles, read only:
  #Server archive.usenet.blueworldhosting.com 563 {
  #  Read *
  #  PostTo !*
  #  Options ssl
  #}
  # The groups eternal-september.* come from eternal-september.org, which
  # needs a (free) account. For each group NewsCache uses the server whose
  # Read pattern matches it most specifically, so eternal-september.* wins
  # over * whatever the order of the entries.
  #Server news.eternal-september.org 563 {
  #  Read eternal-september.*
  #  PostTo eternal-september.*
  #  GroupTimeout 300
  #  User joe
  #  Password secret
  #  Options ssl
  #}
  # Groups that no server should be asked for, and no postings sent to:
  #NoServer {
  #  Read alt.binaries.*
  #  PostTo alt.binaries.*
  #}
}

################################################################
## Timeouts 
################################################################
# Timeouts in seconds for the retrieval of the active database
# (first parameter) and the description of the newsgroups (second
# parameter). If a client requests "list active", then newscache
# checks if the active database timeout is reached and first
# requests the active informations from the upstream servers before
# returning the data to the client. The second parameter has no effect:
# NewsCache doesn't fetch newsgroup descriptions; LIST NEWSGROUPS reads
# the file .newsgroups in the spool directory, which you create yourself.
# Note: if the ServerSpec section
# contains the Options offline or semioffline, then the data will
# be not downloaded from the upstream server. You need updatenews.
# Timeouts 3600 3600

# Disconnect idle client connections after 10 minutes (also clients that
# stop reading their replies, or stop sending in the middle of a POST)
ClientTimeout 600

# After a failed login, wait this many seconds before answering 481
# (0 or 1; default 1). The connection is closed after the third failure.
# AuthFailureDelay 1

# Serve ARTICLE <message-id> and the like from the spool when it has the
# article, using a history in SpoolDirectory/.history (default off)
# History on

# The largest article (bytes) taken from a news server; a larger one is
# refused, and the connection to that server closed (default 1048576)
# MaxArticleSize 1048576

# The largest article (bytes) a client may post; a larger one is refused
# with 441 (default 1048576)
# MaxPostSize 1048576

# Do not allow more than 16 simultaneous connections
# This switch works only in standalone mode
MaxConnections 16

################################################################
## Spool- and Log-Directory
################################################################
# All the cached newsgroups and articles go here
SpoolDirectory /var/cache/newscache

# Size of Spool Directory in KiloBytes
# This value is used by cacheclean, which should be run every 
# few hours by the cron daemon.
SpoolSize 3300000

# All the log files go here, if syslogd is not being used. This
# depends on how NewsCache has been configured: by default it logs to
# syslog and ignores LogDirectory; built with --without-syslog, it
# writes newscache.log here. The programs open their log before they
# switch to Username, so a directory only root can write is enough when
# they start as root; started as Username, that user must be able to
# write the files. Only a regular file with one link is used, not a
# symbolic or hard link (except a symbolic link to stderr).
LogDirectory /var/log/newscache

# Log Style
# All combination of these options are valid:
# strict-inn ... only log INN style messages, omit NewsCache 
#                specific log messages. At the moment this
#                is only supported at the LOG_NOTICE level.
# hostname ... Log the clients hostname, as it is done by INN.
# ip-address ... Log the IP-Address of the client.

# Log both, hostname and ip-address
LogStyle hostname ip-address

################################################################
## Prefetching
################################################################
# The newsgroups listed in this file are prefetched when updatenews
# runs with -g (articles) or -o (overview), for example from cron or
# a systemd timer; the daemon itself doesn't read the file. One group
# per line; a line may also be a wildmat pattern (de.*) or !pattern to
# leave groups out. Lines starting with # are skipped. Without
# PrefetchFile, updatenews only refreshes the active database.
#PrefetchFile /etc/newscache.prefetch
