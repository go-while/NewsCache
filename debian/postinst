#!/bin/sh
set -e

if [ "$1" = "configure" ]; then
	# newscache and newscacheclean switch to user and group news
	# (base-passwd), which must own the spool.
	if ! dpkg-statoverride --list /var/cache/newscache >/dev/null 2>&1; then
		chown news:news /var/cache/newscache
		chmod 0750 /var/cache/newscache
	fi
fi

#DEBHELPER#

exit 0
