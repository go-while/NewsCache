#!/usr/bin/make -f

export DEB_BUILD_MAINT_OPTIONS = hardening=+all
# Keep "make install" from writing /usr/share/info/dir.
export AM_UPDATE_INFO_DIR = no

%:
	dh $@

# ./autogen runs "autoreconf -i". dh_autoreconf's default "autoreconf -f -i"
# would replace INSTALL and doc/texinfo.tex, and "clean" would then delete
# them from the git tree.
override_dh_autoreconf:
	dh_autoreconf ./autogen

# dh_auto_configure already passes --prefix=/usr --sysconfdir=/etc
# --localstatedir=/var.
override_dh_auto_configure:
	dh_auto_configure -- --with-pam --with-gnutls

override_dh_auto_clean:
	dh_auto_clean
	# Built by make and make check, but not removed by distclean.
	rm -f doc/NewsCache.info NServer-0.9.1/checks/article*.out

override_dh_auto_install:
	dh_auto_install
	# The samples go to /usr/share/doc/newscache/examples (debian/examples);
	# /etc/newscache.conf is a working config that lets nobody in.
	rm debian/newscache/etc/newscache.conf-dist \
	   debian/newscache/etc/newscache.auth-dist
	install -m 0644 debian/newscache.conf debian/newscache/etc/newscache.conf

override_dh_installsystemd:
	dh_installsystemd
	# Enable and start only the timer, not the cleanup itself.
	dh_installsystemd --name=newscacheclean newscacheclean.timer
